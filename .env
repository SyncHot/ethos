# =============================================================================
# EthOS - Environment Configuration Example
# Copy this file to .env and modify as needed
# =============================================================================

# ── Core Settings ───────────────────────────────────────────────────
# NAS display name (shown in web UI)
NAS_NAME=EthOS

# Timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Europe/Warsaw

# ── Port Mappings ───────────────────────────────────────────────────
# Main web interface port
ETHOS_PORT=9000

# SSH port (optional - for remote access)
SSH_PORT=2222

# Samba file sharing ports
SAMBA_PORT=445
NETBIOS_PORT=139

# HTTP/HTTPS redirect ports
HTTP_PORT=80
HTTPS_PORT=443

# ── Volume Mounts ───────────────────────────────────────────────────
# Host path for user home directories
USER_HOME_MOUNT=/home

# Media storage mounts (optional)
MEDIA_MOUNT=/media
MNT_MOUNT=/mnt

# External data disk mount point (for large storage)
DATA_DISK=

# ── Docker Settings ────────────────────────────────────────────────
# Image registry (for pulling base images)
DOCKER_REGISTRY=docker.io

# Image tag
IMAGE_TAG=latest

# Build arguments
BUILDKIT_INLINE_CACHE=1

# ── Development Mode ───────────────────────────────────────────────
# Set to true for development environment
FLASK_ENV=production
DEBUG=false

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
