# EthOS Configuration Example
# Copy to .env and adjust as needed

# System User
ETHOS_USER=nasadmin
# ETHOS_ROOT=/home/${ETHOS_USER}/docker/nasos
# COMPOSE_ROOT=/home/${ETHOS_USER}/docker

# Copilot Agent Credentials
ETHOS_COPILOT_USER=nasadmin
ETHOS_COPILOT_PASS=ethos

# Optional: Path to Copilot CLI
# COPILOT_BIN_PATH=/home/${ETHOS_USER}/.local/bin/copilot
